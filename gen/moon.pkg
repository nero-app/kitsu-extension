        "wasmExportGetEntryPostReturn:cabi_post_nero:extension/tracker@0.1.0-draft-2026-10-15#get-entry",
        "wasmExportGetSeriesEpisodes:nero:extension/extractor@0.1.0-draft-2026-10-15#get-series-episodes",
        "wasmExportGetSeriesEpisodesPostReturn:cabi_post_nero:extension/extractor@0.1.0-draft-2026-10-15#get-series-episodes",
        "wasmExportGetSeriesInfo:nero:extension/extractor@0.1.0-draft-2026-10-15#get-series-info",
        "wasmExportGetSeriesInfoPostReturn:cabi_post_nero:extension/extractor@0.1.0-draft-2026-10-15#get-series-info",
        "wasmExportGetSeriesVideos:nero:extension/extractor@0.1.0-draft-2026-10-15#get-series-videos",
        "wasmExportGetSeriesVideosPostReturn:cabi_post_nero:extension/extractor@0.1.0-draft-2026-10-15#get-series-videos",
        "wasmExportListEntries:nero:extension/tracker@0.1.0-draft-2026-10-15#list-entries",
        "wasmExportListEntriesPostReturn:cabi_post_nero:extension/tracker@0.1.0-draft-2026-10-15#list-entries",
        "wasmExportRemoveEntry:nero:extension/tracker@0.1.0-draft-2026-10-15#remove-entry",
        "wasmExportRemoveEntryPostReturn:cabi_post_nero:extension/tracker@0.1.0-draft-2026-10-15#remove-entry",
        "wasmExportSaveEntry:nero:extension/tracker@0.1.0-draft-2026-10-15#save-entry",
        "wasmExportSaveEntryPostReturn:cabi_post_nero:extension/tracker@0.1.0-draft-2026-10-15#save-entry",
        "wasmExportSearch:nero:extension/extractor@0.1.0-draft-2026-10-15#search",
        "wasmExportSearchPostReturn:cabi_post_nero:extension/extractor@0.1.0-draft-2026-10-15#search",
      ],
    },
